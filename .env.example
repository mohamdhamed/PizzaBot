# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_DB=pizzabot
POSTGRES_USER=pizzabot
POSTGRES_PASSWORD=change-me
# Host `db` is the compose service name on pizzabot_net.
# URL-encode the password if it contains special characters.
DATABASE_URL=postgresql://pizzabot:change-me@db:5432/pizzabot
# Bot token from @BotFather (Telegram). Secret: never commit, never log.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# The one restaurant this bot serves; must exist in the database
# (`python -m pizzabot.db.seed_demo` creates "demo").
RESTAURANT_ID=demo
